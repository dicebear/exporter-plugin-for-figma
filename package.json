{
  "name": "@dicebear/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "run-p dev:ui dev:code",
    "dev:ui": "vite build --watch",
    "dev:code": "vite build --config vite.config.code.ts --watch",
    "build": "run-s notices type-check build-ui build-code",
    "build-ui": "vite build",
    "build-code": "vite build --config vite.config.code.ts",
    "analyze": "vite build --mode analyze",
    "type-check": "tsc -b",
    "test": "vitest run",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@dicebear/core": "^11.0.0-rc.1",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rgb-hex": "^4.1.0",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  }
}
